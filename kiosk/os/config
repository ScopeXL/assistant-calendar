# Sunroom OS's pi-gen settings (docs/SUNROOM-OS.md). kiosk/os/build.sh fills in @VERSION@ and
# @PASSWORD@ and writes the result into its pi-gen checkout; a filled copy is never committed.
IMG_NAME="sunroom-os"
IMG_FILENAME="sunroom-os-@VERSION@-pi-arm64"
ARCHIVE_FILENAME="sunroom-os-@VERSION@-pi-arm64"
PI_GEN_RELEASE="Sunroom OS @VERSION@"
RELEASE="trixie"
TARGET_HOSTNAME="sunroom"
FIRST_USER_NAME="sunroom"
# pi-gen won't skip the first-boot rename without a password. This one is random, made for each
# build and kept nowhere, and stage-sunroom locks the account: it only logs in to the desktop.
FIRST_USER_PASS="@PASSWORD@"
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
ENABLE_CLOUD_INIT=1
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="Etc/UTC"
DEPLOY_COMPRESSION="xz"
COMPRESSION_LEVEL=6
STAGE_LIST="stage0 stage1 stage2 stage-sunroom"
