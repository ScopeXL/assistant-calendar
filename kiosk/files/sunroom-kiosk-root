#!/usr/bin/python3
"""sunroom-kiosk-root: the few things Sunroom Screen does as root on a Raspberry Pi, and on
another Linux computer the browser's policy alone (ADR 0038).

Allowed by /etc/sudoers.d/sunroom-kiosk for the screen's user, with no password, and nothing
else; it checks everything it's given (docs/KIOSK.md, docs/M7.md T7):

  write-policy PATH   the browser's managed policy, JSON on stdin: PATH must be
                      sunroom-kiosk.json in one browser's policy folder, and the keys only
                      Sunroom Screen's own (kiosk/agent policy.py lists the same)
  apt-upgrade         the system's own updates: unattended-upgrade when it's installed (Sunroom
                      OS), else apt-get's upgrade
  update-sunroom      /opt/sunroom/update.sh, the all-in-one Pi's own Sunroom
  run-sunroom         Sunroom OS: start the Sunroom the image set up in /opt/sunroom (docker
                      compose pull, printing its progress for the percent, then up -d) under this
                      screen's own name (Imager may have renamed it), and announce it (avahi)

The system's Python, standard library only; root-owned in /usr/local/sbin.
"""

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile

POLICY_FILES = {
    "/etc/chromium/policies/managed/sunroom-kiosk.json",
    "/etc/opt/chrome/policies/managed/sunroom-kiosk.json",
    "/etc/opt/edge/policies/managed/sunroom-kiosk.json",
}
ALLOWED_KEYS = {
    "MetricsReportingEnabled",
    "BackgroundModeEnabled",
    "PasswordManagerEnabled",
    "TranslateEnabled",
    "DefaultBrowserSettingEnabled",
    "BrowserSignin",
    "PromotionsEnabled",
    "ComponentUpdatesEnabled",
    "LocalNetworkAccessAllowedForUrls",
    "LocalNetworkAccessRestrictionsEnabled",
}
UPDATE_SH = "/opt/sunroom/update.sh"
SERVER_DIR = "/opt/sunroom"
COMPOSE_FILE = SERVER_DIR + "/docker-compose.yml"
# The image renders kiosk/files/avahi/sunroom.service here; it's announced only once Sunroom runs.
AVAHI_FILE = "/usr/local/share/sunroom-kiosk/sunroom.service"
AVAHI_SERVICE = "/etc/avahi/services/sunroom.service"
MOST_BYTES = 64 * 1024


def refuse(message):
    print(message, file=sys.stderr)
    return 2


def plain(value):
    if isinstance(value, bool) or isinstance(value, int) or isinstance(value, str):
        return True
    return isinstance(value, list) and all(isinstance(item, str) for item in value)


def write_policy(path):
    if path not in POLICY_FILES:
        return refuse("That isn't a policy file Sunroom Screen writes.")
    data = sys.stdin.read(MOST_BYTES + 1)
    if len(data) > MOST_BYTES:
        return refuse("That policy is too big.")
    try:
        policy = json.loads(data)
    except ValueError:
        return refuse("That policy isn't JSON.")
    if not isinstance(policy, dict) or set(policy) - ALLOWED_KEYS:
        return refuse("That policy has keys Sunroom Screen doesn't write.")
    if not all(plain(value) for value in policy.values()):
        return refuse("That policy has values Sunroom Screen doesn't write.")
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o755, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=folder, prefix=".sunroom-kiosk.")
    with os.fdopen(handle, "w", encoding="utf-8") as out:
        json.dump(policy, out, indent=2, sort_keys=True)
        out.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return 0


def apt_upgrade():
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if shutil.which("unattended-upgrade"):
        return subprocess.call(["unattended-upgrade"], env=env)
    if subprocess.call(["apt-get", "-q", "update"], env=env) != 0:
        return 1
    return subprocess.call(["apt-get", "-q", "-y", "upgrade"], env=env)


def update_sunroom():
    if not os.path.isfile(UPDATE_SH):
        return refuse("Sunroom doesn't run on this Pi.")
    return subprocess.call([UPDATE_SH])


ADVERTISED = re.compile(r'(SUNROOM_ADVERTISED_URL: ")[^"]*(")')


def name_it():
    """The address phones open (and the QR codes show): this screen's own name, as it is now."""
    host = socket.gethostname().split(".")[0].lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", host):
        return
    with open(COMPOSE_FILE, encoding="utf-8") as handle:
        text = handle.read()
    named = ADVERTISED.sub(lambda m: m.group(1) + "http://" + host + ".local:8080" + m.group(2), text)
    if named != text:
        with open(COMPOSE_FILE, "w", encoding="utf-8") as handle:
            handle.write(named)


def run_sunroom():
    if not os.path.isfile(COMPOSE_FILE):
        return refuse("Sunroom isn't set up to run on this screen.")
    name_it()
    compose = [
        "docker", "compose", "--project-directory", SERVER_DIR, "-f", COMPOSE_FILE,
        "--progress", "plain",
    ]
    sys.stdout.flush()
    if subprocess.call(compose + ["pull"]) != 0 or subprocess.call(compose + ["up", "-d"]) != 0:
        return 1
    if os.path.isfile(AVAHI_FILE) and os.path.isdir(os.path.dirname(AVAHI_SERVICE)):
        shutil.copyfile(AVAHI_FILE, AVAHI_SERVICE)
        os.chmod(AVAHI_SERVICE, 0o644)
    return 0


def main(argv):
    if os.geteuid() != 0:
        return refuse("Run me with sudo.")
    if argv[:1] == ["write-policy"] and len(argv) == 2:
        return write_policy(argv[1])
    if argv == ["apt-upgrade"]:
        return apt_upgrade()
    if argv == ["update-sunroom"]:
        return update_sunroom()
    if argv == ["run-sunroom"]:
        return run_sunroom()
    return refuse(
        "Usage: sunroom-kiosk-root write-policy PATH | apt-upgrade | update-sunroom | run-sunroom"
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
